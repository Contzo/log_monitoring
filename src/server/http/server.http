@host = http://localhost:3000


### Add server
POST {{host}}/server
Content-Type: application/json

{
  "serverName": "nms_ciurel", 
  "serverIp": "127.0.0.2", 
  "password": "test",
  "sshUser": "root", 
  "sshPort": 2223
}


### Get all the server
GET {{host}}/server
Content-Type: application/json

### Enable the server
PATCH {{host}}/server/enable/1
Content-Type: application/json

### Disable the server
PATCH {{host}}/server/disable/1
Content-Type: application/json

