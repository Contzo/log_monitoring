@host = http://localhost:3000


### Add file
POST {{host}}/log-file
sontent-Type: application/json

{
  "logPath": "/root/log_file/test_file.txt" ,
  "serverName": "nms_ciurel"
}

### Enable log file monitoring
PATCH {{host}}/log-file/enable/1
sontent-Type: application/json

### Add file
POST {{host}}/log-file
sontent-Type: application/json

{
  "logPath": "/root/log_file/test_file.txt" ,
  "serverName": "nms_sabareni"
}

### Enable log file monitoring
PATCH {{host}}/log-file/enable/2
sontent-Type: application/json

### Disable log file monitoring
PATCH {{host}}/log-file/disable/2
sontent-Type: application/json




### Get all the log files 
GET {{host}}/log-file
sontent-Type: application/json

